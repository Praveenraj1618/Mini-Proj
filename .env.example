# ----------------------------------------------------
# Legal Document Intelligence System — Configuration
# ----------------------------------------------------

# Provide at least one API key for LLM Analysis & Grounded Q&A:
# Option 1: xAI Grok
XAI_API_KEY=
XAI_MODEL=grok-4

# Option 2: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Option 3: Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none

# Option 4: Google Gemini (used after Groq by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.7-flash

# Optional provider failover order
LLM_PROVIDER_ORDER=xai,openai,groq,gemini
LLM_REQUEST_TIMEOUT=45

# HuggingFace & Symlink options (Optional)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_TOKEN=your_huggingface_token_here

# Chunking & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=3
TOP_K_DENSE=10
TOP_K_BM25=10
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_UPLOAD_MB=20
# Set true to force evidence-only deterministic behavior without LLM calls.
LEGAL_AI_OFFLINE=false

# Runtime retrieval switches (restart the backend after changing .env).
HYBRID_RETRIEVAL_ENABLED=true
RERANKER_ENABLED=true

# Summary processes all readable contract pages using bounded evidence windows.
SUMMARY_CONTEXT_CHARS=12000

# Local OCR for scanned pages. Install Tesseract and the requested language data.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
# Directory containing eng.traineddata (use an absolute path if discovery fails).
# OCR_TESSDATA=C:/Program Files/Tesseract-OCR/tessdata

# Page previews include raster images and vector signatures/stamps.
MAX_VISUAL_PAGES=5
# Set a vision-capable model supported by a configured provider to enable AI visual analysis.
# OPENAI_VISION_MODEL=gpt-4o
# XAI_VISION_MODEL=<your-supported-vision-model>
# GROQ_VISION_MODEL=<your-supported-vision-model>
# GEMINI_VISION_MODEL=<your-supported-vision-model>
